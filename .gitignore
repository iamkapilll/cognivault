# ============================================================
# Cognivault AI — .gitignore
# Rules are grouped by ecosystem. Example env files are kept
# on purpose: they document required variables without secrets.
# ============================================================

# ---------- Python: virtual environments ----------
.venv/
venv/
env/
ENV/
.python-version



backend/uploads/
backend/.env
backend/.venv/

# ---------- Python: bytecode and packaging ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
pip-log.txt

# ---------- Python: test, lint, type-check caches ----------
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---------- Node / Next.js ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.next/
out/
.swc/
.turbo/
.vercel/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------- Environment files and secrets ----------
# Ignore real env files at any depth, but keep the example variants.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Key material and credentials
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# ---------- Local databases and generated data ----------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
pgdata/
postgres-data/
uploads/
storage/
data/

# ---------- Logs ----------
logs/
*.log

# ---------- Editors and IDEs ----------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ---------- OS temporary and metadata files ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- Miscellaneous local artifacts ----------
.cache/
tmp/
*.tmp
*.bak
*.orig
