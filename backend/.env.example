# Cognivault AI backend configuration.
# Copy this file to backend/.env and replace every placeholder.
# backend/.env is git-ignored; never commit real values.

# PostgreSQL connection string used by SQLAlchemy, Alembic and LangGraph.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=cognivault_access_token
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Browser origins allowed to call the API (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploads. Leave UPLOAD_DIR unset for backend/uploads.
# UPLOAD_DIR=
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=20

# Retrieval quality gate: lower distance means a closer match.
RAG_MAX_DISTANCE=0.75

# AI providers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=

# Full path to tesseract.exe on Windows; leave empty on Linux/Docker.
TESSERACT_CMD=

# Login and registration rate limiting (per client IP).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900

# Set to true in production; requires COOKIE_SECURE=true.
PRODUCTION=false
